{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "prebuild": "tsx scripts/bundle-migrations.ts",
    "build": "npm run prebuild && tsc -b",
    "migrate": "node dist/db/migrate.js",
    "migrate:dev": "tsx scripts/bundle-migrations.ts && tsx src/db/migrate.ts",
    "seed": "node dist/db/seed.js",
    "seed:dev": "tsx src/db/seed.ts",
    "start": "node dist/index.js",
    "test": "tsx --test src/tests/**/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  }
}
