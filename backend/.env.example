# Puerto y entorno del servidor
PORT=3000
NODE_ENV=development

# Origen permitido para CORS (frontend local o GitHub Pages en prod)
FRONTEND_URL=http://localhost:5173

# Base de datos PostgreSQL (local con Docker o URL remota de Render/Neon/Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gastrosena
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/gastrosena_test

# Clave secreta para firmar tokens JWT (OBLIGATORIA: el servidor no arranca sin ella)
JWT_SECRET=gastrosena_jwt_super_secret_key_desarrollo_local_2026_sena

# Bootstrap automático del primer encargado (se crea al migrar si no existe ninguno)
ADMIN_DOCUMENT=1012345678
ADMIN_PASSWORD=demo123
ADMIN_NAME=Encargado General Comedor
ADMIN_EMAIL=encargado@sena.edu.co

# Control de seed en producción (dejar en false en servidores públicos)
SEED_DEMO=false
