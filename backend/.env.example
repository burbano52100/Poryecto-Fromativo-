# Puerto y entorno del servidor
PORT=3000
NODE_ENV=development

# Origen permitido para CORS (frontend local o GitHub Pages en prod)
FRONTEND_URL=http://localhost:5173

# Base de datos PostgreSQL instalado localmente (o URL remota de Render/Neon/Supabase).
# DATABASE_URL_TEST debe ser una base distinta: los tests la vacían en cada corrida.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gastrosena
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/gastrosena_test

# Clave secreta para firmar tokens JWT (OBLIGATORIA: el servidor no arranca sin ella)
JWT_SECRET=gastrosena_jwt_super_secret_key_desarrollo_local_2026_sena

# Bootstrap automático del primer encargado (se crea al migrar si no existe ninguno)
ADMIN_DOCUMENT=1012345678
ADMIN_PASSWORD=demo123
ADMIN_NAME=Encargado General Comedor
ADMIN_EMAIL=encargado@sena.edu.co

# Bootstrap automático del primer coordinador (se crea al migrar si no existe ninguno).
# Es quien aprueba las cuentas de aprendiz e instructor: sin él nadie puede ingresar en producción.
COORDINADOR_DOCUMENT=1023456789
COORDINADOR_PASSWORD=demo123
COORDINADOR_NAME=Coordinadora Académica Yamboró
COORDINADOR_EMAIL=coordinacion@sena.edu.co

# Correo SMTP para los recordatorios de deuda a instructores (ADR 023). Es opcional: sin SMTP_HOST
# los correos no se envían, se imprimen en la consola ("modo prueba").
# SMTP_PORT: 587 (STARTTLS, por defecto) o 465 (TLS directo).
# SMTP_FROM: remitente, por ejemplo "GastroSENA <cuenta@dominio>"; si se deja vacío se usa SMTP_USER.
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=la cuenta y SMTP_PASS=una contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Pago con el código QR (ADR 027): palabras del dueño del QR que deben aparecer en el comprobante,
# separadas por coma. Por defecto SURCOLOM ("CENTR GEST SURCOLOM").
DESTINATARIO_PAGO_QR=SURCOLOM

# Control de seed en producción (dejar en false en servidores públicos)
SEED_DEMO=false
